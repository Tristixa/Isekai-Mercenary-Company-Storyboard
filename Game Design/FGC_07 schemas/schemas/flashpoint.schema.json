{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flashpoint.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "rev": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "gdd": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "authoring_status": {
      "enum": [
        "specified",
        "incomplete"
      ]
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "gate": {
      "$ref": "shared.schema.json#/$defs/predicate"
    },
    "boss_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "approach_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "reward": {
      "$ref": "shared.schema.json#/$defs/reward"
    },
    "completion_flag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "aftermath": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "value": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          },
          "duration_actions": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "op",
          "target",
          "value",
          "duration_actions"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "offer_duration_seconds": {
      "type": "null"
    },
    "failure_rep": {
      "const": 0
    },
    "repeat_reward": {
      "const": false
    },
    "guest_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "minItems": 0
    }
  },
  "required": [
    "id",
    "region",
    "rev",
    "name",
    "gdd",
    "authoring_status",
    "missing_fields",
    "gate",
    "boss_id",
    "approach_seconds",
    "reward",
    "completion_flag",
    "aftermath",
    "offer_duration_seconds",
    "failure_rep",
    "repeat_reward",
    "guest_ids"
  ],
  "additionalProperties": false
}
