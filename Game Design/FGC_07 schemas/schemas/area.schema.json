{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "area.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "rev": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "gdd": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "authoring_status": {
      "enum": [
        "specified",
        "incomplete"
      ]
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "base_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "rank_required": {
      "enum": [
        "f",
        "e",
        "d",
        "c",
        "b",
        "a",
        "s"
      ]
    },
    "ordinary_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "minItems": 3
    },
    "landmark_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "minItems": 3
    },
    "path_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "minItems": 2
    },
    "rare_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "minItems": 0
    },
    "boss_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "minItems": 0
    },
    "scout_injury_chance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "initial_exploration_pct": {
      "const": 0
    },
    "route_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "value": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          },
          "duration_actions": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "op",
          "target",
          "value",
          "duration_actions"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "id",
    "region",
    "rev",
    "name",
    "gdd",
    "authoring_status",
    "missing_fields",
    "base_id",
    "rank_required",
    "ordinary_ids",
    "landmark_ids",
    "path_ids",
    "rare_ids",
    "boss_ids",
    "scout_injury_chance",
    "initial_exploration_pct",
    "route_rules"
  ],
  "additionalProperties": false
}
