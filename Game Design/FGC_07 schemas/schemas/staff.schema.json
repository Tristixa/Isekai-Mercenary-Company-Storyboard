{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "staff.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "rev": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "gdd": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "authoring_status": {
      "enum": [
        "specified",
        "incomplete"
      ]
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "role": {
      "enum": [
        "processor",
        "craftsman",
        "clerk"
      ]
    },
    "hire_g": {
      "type": "integer",
      "minimum": 0
    },
    "weekly_wage_g": {
      "type": "integer",
      "minimum": 0
    },
    "station_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "gate": {
      "$ref": "shared.schema.json#/$defs/predicate"
    },
    "ranks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rank": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "productive_hours": {
            "type": "number",
            "minimum": 0
          },
          "promotion_g": {
            "type": "integer",
            "minimum": 0
          },
          "duration_factor": {
            "type": "number",
            "minimum": 0
          },
          "wage_factor": {
            "type": "number",
            "minimum": 0
          },
          "requires_frontier": {
            "type": "boolean"
          }
        },
        "required": [
          "rank",
          "productive_hours",
          "promotion_g",
          "duration_factor",
          "wage_factor",
          "requires_frontier"
        ],
        "additionalProperties": false
      },
      "minItems": 3
    }
  },
  "required": [
    "id",
    "region",
    "rev",
    "name",
    "gdd",
    "authoring_status",
    "missing_fields",
    "role",
    "hire_g",
    "weekly_wage_g",
    "station_kind",
    "gate",
    "ranks"
  ],
  "additionalProperties": false
}
